# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uptime"

# Redis connection string (used by producer.ts and worker.ts)
REDIS_URL="redis://localhost:6379"

# Secret used to sign and verify JWT session cookies (use a long random value in production)
JWT_SECRET="replace-with-a-strong-random-secret"

# Optional tuning
PRODUCER_INTERVAL_MS="60000"
PROBE_TIMEOUT_MS="5000"
